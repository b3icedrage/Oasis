{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GRADLE_OPTS": "-Xmx4g -XX:MaxMetaspaceSize=2g -Dorg.gradle.daemon=false -Dorg.gradle.workers.max=2 -Dandroid.enableLintVitalRelease=false",
        "JAVA_OPTS": "-Xmx4g -XX:MaxMetaspaceSize=2g"
      },
      "android": {
        "gradleCommand": "app:assembleRelease --no-daemon"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
