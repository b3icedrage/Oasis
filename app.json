{
  "expo": {
    "name": "GlitchIt",
    "slug": "glitchit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "glitchit",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.glitchit.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070d"
      },
      "package": "com.glitchit.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GlitchIt to access your camera for posting photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GlitchIt to access your photos for posting."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ]
    ]
  }
}
