{
  "expo": {
    "name": "GlitchIt",
    "slug": "glitchit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "glitchit",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.glitchit.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow GlitchIt to access your camera for posting photos.",
        "NSMicrophoneUsageDescription": "Allow GlitchIt to access your microphone for recording videos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070d"
      },
      "package": "com.glitchit.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GlitchIt to access your camera for posting photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GlitchIt to access your photos for posting."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "390023bf-137a-43a2-a374-a32c46e260ab"
      }
    },
    "owner": "b3icedrage"
  }
}
