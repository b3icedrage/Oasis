{
  "expo": {
    "name": "GlitchIt",
    "slug": "glitchit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "glitchit",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07070d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.glitchit.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow GlitchIt to access your camera for posting photos.",
        "NSMicrophoneUsageDescription": "Allow GlitchIt to access your microphone for recording videos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070d"
      },
      "package": "com.glitchit.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "extraGradleProperties": {
        "org.gradle.jvmargs": "-Xmx4g -XX:MaxMetaspaceSize=2g -XX:+HeapDumpOnOutOfMemoryError --no-daemon",
        "android.enableLintVitalRelease": "false",
        "org.gradle.daemon": "false"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-image-picker",
      "expo-media-library",
      "expo-av"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "390023bf-137a-43a2-a374-a32c46e260ab"
      }
    },
    "owner": "b3icedrage"
  }
}
